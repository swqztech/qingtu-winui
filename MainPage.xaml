<?xml version="1.0" encoding="utf-8" ?>

<Page

    x:Class="Qingtu.MainPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>

        <SolidColorBrush x:Key="BgBrush" Color="#1A2629"/>

        <SolidColorBrush x:Key="CardBrush" Color="#1E2C30"/>

        <SolidColorBrush x:Key="TealBrush" Color="#48C4B6"/>

        <SolidColorBrush x:Key="OrangeBrush" Color="#E68C46"/>

        <SolidColorBrush x:Key="TextBrush" Color="#D2DADE"/>

        <SolidColorBrush x:Key="MutedBrush" Color="#828F96"/>

    </Page.Resources>

    <ScrollViewer Padding="20,12" Background="{StaticResource BgBrush}">

        <StackPanel Spacing="12" MaxWidth="520">

            <TextBlock Text="轻图" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center"/>

            <TextBlock Text="把体积压下去，细节留住" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>

            <TextBlock Text="本地处理 · 不上传 · PNG / JPG / WebP" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center"/>



            <StackPanel Orientation="Horizontal" Spacing="8">

                <Button x:Name="BtnTabCompress" Content="压缩" Click="OnTabCompress"/>

                <Button x:Name="BtnTabStitch" Content="拼接" Click="OnTabStitch"/>

            </StackPanel>



            <Border x:Name="DropArea" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource TealBrush}"

                    BorderThickness="1" CornerRadius="6" Padding="16">

                <StackPanel HorizontalAlignment="Center" Spacing="10">

                    <TextBlock x:Name="TxtDropHint" Text="点击下方选择图片" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>

                    <Button Content="选择图片" Click="OnPickFiles" Background="{StaticResource OrangeBrush}" Foreground="White"/>

                </StackPanel>

            </Border>



            <ListView x:Name="FileList" Height="100" Background="{StaticResource CardBrush}"/>



            <StackPanel x:Name="PanelCompress" Spacing="10" Background="{StaticResource CardBrush}" Padding="14">

                <Grid ColumnSpacing="8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="56"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="40"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="质量" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                    <Slider x:Name="SliderQuality" Grid.Column="1" Minimum="1" Maximum="100" Value="80"/>

                    <TextBlock x:Name="TxtQuality" Grid.Column="2" Text="80" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>

                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">

                    <TextBlock Text="最长边" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                    <TextBox x:Name="TxtMaxSide" Text="0" Width="72"/>

                    <TextBlock Text="px（0 = 不缩放）" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>

                </StackPanel>

                <TextBlock Text="输出格式" Foreground="{StaticResource MutedBrush}"/>

                <StackPanel Orientation="Horizontal" Spacing="12">

                    <RadioButton x:Name="FmtKeep" Content="保持原格式" GroupName="Fmt" IsChecked="True"/>

                    <RadioButton x:Name="FmtJpeg" Content="JPEG" GroupName="Fmt"/>

                    <RadioButton x:Name="FmtPng" Content="PNG" GroupName="Fmt"/>

                    <RadioButton x:Name="FmtWebp" Content="WebP" GroupName="Fmt"/>

                </StackPanel>

            </StackPanel>



            <TextBlock x:Name="TxtStitchHint" Text="按列表顺序横向拼接，高度对齐最短边" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>



            <CheckBox x:Name="ChkCustomOut" Content="自定义输出目录"/>

            <Grid ColumnSpacing="8">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtOutDir" PlaceholderText="默认：源文件旁 /compressed"/>

                <Button Grid.Column="1" Content="浏览…" Click="OnPickOutDir"/>

            </Grid>



            <StackPanel Orientation="Horizontal" Spacing="10">

                <Button x:Name="BtnRun" Content="开始压缩 (0)" Click="OnRun" Background="{StaticResource OrangeBrush}" Foreground="White"/>

                <Button Content="清空列表" Click="OnClear"/>

            </StackPanel>



            <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80" Background="{StaticResource CardBrush}"/>

        </StackPanel>

    </ScrollViewer>

</Page>


